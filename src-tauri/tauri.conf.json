{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "语音提示增强器",
  "version": "0.1.0",
  "identifier": "com.voiceprompt.ide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "语音提示增强器",
        "label": "main",
        "width": 1120,
        "height": 820,
        "minWidth": 980,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../backend/process_voice_prompt.py",
      "../backend/record_audio.swift"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
